# Domínio público utilizado pelo Traefik e painel web
EMPIREMUSE_DOMAIN=muse.seudominio.com

# Tokens dos bots Discord (um por variável, detectados automaticamente pelo pool)
TOKEN=
TOKEN_2=
TOKEN_3=
TOKEN_4=
TOKEN_5=

# IDs dos administradores (separados por espaço) e URI do MongoDB
OWNER_IDS=
MONGO=

# Integração Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Integração Last.fm
LASTFM_KEY=
LASTFM_SECRET=

# Painel administrativo web (OAuth Discord e cookie secret)
PANEL_OAUTH_CLIENT_ID=
PANEL_OAUTH_CLIENT_SECRET=
PANEL_COOKIE_SECRET=

# Segredo do relé RPC (vazio = gera efêmero por processo)
RPC_SERVER_SECRET=

# Refresh token do YouTube OAuth (cliente TV) obtido com conta descartável via /ytoauth
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Webhooks de monitoramento e relatórios de erro
BOT_ADD_REMOVE_LOG=
ERROR_REPORT_WEBHOOK=
AUTO_ERROR_REPORT_WEBHOOK=
