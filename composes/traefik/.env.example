# Obrigatório: e-mail da conta no Let's Encrypt (avisos de expiração do certificado de origem).
ACME_EMAIL=

# Opcional: nível de log do Traefik (DEBUG, INFO, WARN, ERROR). Padrão: INFO.
# TRAEFIK_LOG_LEVEL=INFO

# Opcional: faixas da Cloudflare em que o Traefik confia para X-Forwarded-For / X-Real-IP,
# separadas por vírgula. Padrão: a lista embutida no docker-compose.yml (https://www.cloudflare.com/ips/).
# CF_TRUSTED_IPS=
