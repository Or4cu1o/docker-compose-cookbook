# Faixas da Cloudflare (https://www.cloudflare.com/ips/), separadas por vírgula, conferidas em 2026-10-24.
# Usadas para aceitar só tráfego da Cloudflare (ipAllowList) e para confiar no IP real (forwardedHeaders).
# Ficam em duas variáveis porque alguns painéis limitam cada valor a 256 caracteres.
CF_IPS_V4=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
CF_IPS_V6=2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# Nível de log do Traefik (DEBUG, INFO, WARN, ERROR).
TRAEFIK_LOG_LEVEL=INFO

# Versão mínima de TLS entre a Cloudflare e a origem (VersionTLS12 ou VersionTLS13).
TLS_MIN_VERSION=VersionTLS12

# HSTS em segundos (31536000 = 1 ano).
HSTS_SECONDS=31536000
